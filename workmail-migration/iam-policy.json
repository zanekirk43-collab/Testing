{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkMailReadAndExport",
      "Effect": "Allow",
      "Action": [
        "workmail:Describe*",
        "workmail:List*",
        "workmail:Get*",
        "workmail:StartMailboxExportJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53Dns",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::workmail-backup-*",
        "arn:aws:s3:::workmail-backup-*/*"
      ]
    },
    {
      "Sid": "ExportEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:ListAliases",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ExportRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/WorkMailExportRole"
    }
  ]
}
